{
  "type": "module",
  "name": "oneapp",
  "version": "1.29.0",
  "description": "OneApp - 多功能开发工具",
  "author": "kaituoC <changktforever@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaituoC/OneApp.git"
  },
  "bugs": {
    "url": "https://github.com/kaituoC/OneApp/issues"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.4.21",
    "codemirror": "^6.0.1",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.11",
    "electron-store": "^8.1.0",
    "fast-xml-parser": "^5.9.3",
    "js-md5": "^0.8.3",
    "jsonpath-plus": "^10.4.0",
    "lucide-vue-next": "^0.577.0",
    "marked": "^12.0.0",
    "papaparse": "^5.5.4",
    "postcss": "^8.5.10",
    "qrcode": "^1.5.4",
    "sql-formatter": "^15.8.2",
    "vue": "^3.4.21",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.0.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "vite": "^5.0.0",
    "vitest": "^4.1.4"
  },
  "build": {
    "appId": "com.oneapp.dev",
    "productName": "OneApp",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "electron/assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "iconSize": 80,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 180,
          "y": 170
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OneApp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "license": "LICENSE"
    },
    "files": [
      "out/**/*",
      "electron/assets/**/*"
    ]
  }
}
